# Copy to .env and adjust. Every setting has a sensible default except DATABASE_URL.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Public base URL of this API (used for uploaded file URLs and links).
PUBLIC_URL=http://localhost:4000
LOG_LEVEL=info

# --- PostgreSQL ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ride_sangai
# Tests use their own database; defaults to DATABASE_URL with `_test` appended.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ride_sangai_test
# Only needed for `npm run db:migrate:dev` (creating new migrations).
# SHADOW_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ride_sangai_shadow
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=10000
DB_SSL=false

# --- Auth ---------------------------------------------------------------------
# REQUIRED in production: a long random string (openssl rand -base64 48).
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# Where the reset email links to; {token} is replaced.
PASSWORD_RESET_URL=yatrix://reset-password?token={token}

# --- HTTP ---------------------------------------------------------------------
# '*' allows any origin (fine for the native app); otherwise a comma-separated list.
CORS_ORIGINS=*
# Set to true behind a reverse proxy / load balancer so client IPs are correct.
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
# Swagger UI at /docs (defaults to off in production).
DOCS_ENABLED=true

# --- Uploads ------------------------------------------------------------------
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880

# --- Background jobs & realtime -----------------------------------------------
JOBS_ENABLED=true
RIDE_REMINDER_LEAD_MINUTES=120
REALTIME_ENABLED=true
# Fan WebSocket events out across several API instances via Postgres LISTEN/NOTIFY.
REALTIME_PG_FANOUT=false

# --- Seed (npm run db:seed) ----------------------------------------------------
# The superadmin account for the web dashboard. In production the password is
# required (12+ characters); in development it defaults to Test@1234.
# SEED_SUPERADMIN_EMAIL=admin@gmail.com
# SEED_SUPERADMIN_PASSWORD=
# SEED_SUPERADMIN_NAME=Super Admin
