# Base URL of the Ride Sangai API (server-side only; never exposed to the browser).
# The dashboard's backend-for-frontend talks to this URL; the browser only talks to Next.js.
API_URL=http://localhost:4000/api/v1

# Optional: the public origin of this dashboard (e.g. https://admin.ridesangai.app).
# Mutating requests must carry an Origin header equal to this. When unset, the
# request's Host / X-Forwarded-Host header is used instead.
# APP_ORIGIN=http://localhost:3000
